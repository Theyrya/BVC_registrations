# SQL Server connection (update for your local SSMS)


# JWT secret used to sign tokens (change for production)
JWT_SECRET=dev_jwt_secret_change_me

# Server port


# Admin account password used by seed script (change before seeding)
ADMIN_PASS=admin123

# Environment
NODE_ENV=development
# Database configuration
DB_SERVER=Theyrya\SQLEXPRESS  # SQL Server instance name
DB_DATABASE=bvc_registrations   # The database name you want to connect to
#DB_DOMAIN=BOWVALLEY           # Your Windows domain --> Just for Windows Authentication
DB_USER=dhairya_sql_class         # Your Windows username
DB_PASSWORD=1234567890     # Leave blank for Windows Authentication
DB_TRUST_SERVER_CERT=true       # Trust the server certificate

# Application configuration
PORT=5000  

                     # The port your Node.js server will run ondd